# `npm run dev` 로 띄울 때만 읽는다 (vite 가 모드별로 자동으로 읽는다).
#
# 이 파일이 없으면 apiClient 의 기본값이 운영 API 라, 로컬에서 개발하는 동안
# 운영 데이터를 읽고 쓰게 된다. 실제로 로컬만 화면이 다르게 도는 원인이었다.
#
# 빌드(`npm run build`)는 이 파일을 읽지 않는다. 배포는 Vercel 환경변수를 쓴다.
VITE_API_URL=https://dev.api.farmassi.kr
# API/카카오 로그인 없이 /admin 진입 (로컬 화면 작업용). 서버 복구 후 false 로 끄면 된다.
VITE_DEV_BYPASS_AUTH=true
